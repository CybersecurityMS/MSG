# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic Claude API credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5

# Folders the agent watches / writes to (relative to project root)
INCOMING_DIR=data/incoming
PROCESSED_DIR=data/processed
OUTPUT_DIR=data/output/alerts
TICKETS_DIR=data/tickets

# How often (minutes) the agent polls the incoming folder
POLL_INTERVAL_MINUTES=5

# LangSmith tracing - lets you inspect every agent run (each graph step, and each
# Claude call with its prompt/response/tokens) at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=soc-ai
# Only required if your API key is org-scoped rather than tied to one workspace
# (if every call 403s despite a valid key, this is almost always why). Found in
# the LangSmith URL: smith.langchain.com/o/<this-id>/settings/apikeys
LANGSMITH_WORKSPACE_ID=your_langsmith_workspace_id_here
